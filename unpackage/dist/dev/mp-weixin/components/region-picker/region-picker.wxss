.region-picker .mask.data-v-d612b0d8 {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.region-picker .mask.show.data-v-d612b0d8 {
  opacity: 1;
  visibility: visible;
}
.region-picker .picker-container.data-v-d612b0d8 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 999;
  -webkit-transform: translateY(100%);
          transform: translateY(100%);
  transition: -webkit-transform 0.3s ease;
  transition: transform 0.3s ease;
  transition: transform 0.3s ease, -webkit-transform 0.3s ease;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}
.region-picker .picker-container.show.data-v-d612b0d8 {
  -webkit-transform: translateY(0);
          transform: translateY(0);
}
.region-picker .picker-container .picker-header.data-v-d612b0d8 {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}
.region-picker .picker-container .picker-header .cancel-btn.data-v-d612b0d8,
.region-picker .picker-container .picker-header .confirm-btn.data-v-d612b0d8 {
  font-size: 32rpx;
  padding: 10rpx 20rpx;
}
.region-picker .picker-container .picker-header .cancel-btn.data-v-d612b0d8 {
  color: #999;
}
.region-picker .picker-container .picker-header .confirm-btn.data-v-d612b0d8 {
  color: #ff6600;
}
.region-picker .picker-container .picker-content.data-v-d612b0d8 {
  height: 400rpx;
  overflow: hidden;
}
.region-picker .picker-container .picker-content .picker-view.data-v-d612b0d8 {
  height: 100%;
}
.region-picker .picker-container .picker-content .picker-view .picker-item.data-v-d612b0d8 {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  height: 50rpx;
  line-height: 50rpx;
}
