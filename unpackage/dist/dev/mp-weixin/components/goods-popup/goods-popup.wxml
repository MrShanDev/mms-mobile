<view class="goods-popup data-v-7c28e620"><block wx:if="{{show}}"><view data-event-opts="{{[['tap',[['handleMaskClick',['$event']]]]]}}" class="mask data-v-7c28e620" bindtap="__e"></view></block><view class="{{['popup-content','data-v-7c28e620',(show)?'show':'']}}"><view class="popup-header data-v-7c28e620"><text class="tip-text data-v-7c28e620">再来一份，可享受超值加购</text><view data-event-opts="{{[['tap',[['handleClose',['$event']]]]]}}" class="close-btn data-v-7c28e620" bindtap="__e">去抢购</view></view><view class="selected-goods data-v-7c28e620"><view class="section-title-row data-v-7c28e620"><text class="section-title data-v-7c28e620">已选商品</text><view class="action-btns data-v-7c28e620"><text data-event-opts="{{[['tap',[['clearAll',['$event']]]]]}}" class="icon-btn data-v-7c28e620" bindtap="__e"><text class="iconfont icon-shanchu data-v-7c28e620" style="font-size:26rpx;"></text>清空 </text></view></view><scroll-view class="goods-scroll data-v-7c28e620" scroll-y="{{true}}"><block wx:for="{{selectedGoods}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="goods-item data-v-7c28e620"><image class="goods-img data-v-7c28e620" src="{{item.image}}" mode="aspectFill"></image><view class="goods-info data-v-7c28e620"><view class="goods-name data-v-7c28e620">{{item.name}}</view><view class="goods-spec data-v-7c28e620">{{item.spec}}</view><view class="goods-bottom data-v-7c28e620"><text class="price data-v-7c28e620">{{"¥"+item.price}}</text><view class="count-control data-v-7c28e620"><view data-event-opts="{{[['tap',[['decreaseCount',[index]]]]]}}" class="minus-btn data-v-7c28e620" bindtap="__e">−</view><text class="count data-v-7c28e620">{{item.count}}</text><view data-event-opts="{{[['tap',[['increaseCount',[index]]]]]}}" class="plus-btn data-v-7c28e620" bindtap="__e">+</view></view></view></view></view></block></scroll-view></view></view></view>