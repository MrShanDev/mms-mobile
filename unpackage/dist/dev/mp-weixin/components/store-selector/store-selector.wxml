<view class="store-selector data-v-104c27e4"><block wx:if="{{show}}"><view data-event-opts="{{[['tap',[['close',['$event']]]]]}}" class="mask data-v-104c27e4" bindtap="__e"></view></block><view class="{{['popup-content','data-v-104c27e4',(show)?'show':'']}}"><view class="store-head data-v-104c27e4"><view class="store-title m-b-5 data-v-104c27e4"> 请确认就餐门店 </view><view class="store-desc data-v-104c27e4"> 附近门店较多，请确认就餐门店 </view></view><view class="store-list data-v-104c27e4"><block wx:for="{{storeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectStore',['$0'],[[['storeList','',index]]]]]]]}}" class="store-item data-v-104c27e4" bindtap="__e"><view class="store-info data-v-104c27e4"><view class="store-header data-v-104c27e4"><text class="store-name data-v-104c27e4">{{item.name}}</text><block wx:if="{{item.status==='营业中'}}"><view class="store-badge data-v-104c27e4">{{item.status}}</view></block></view><view class="store-detail data-v-104c27e4"><text class="detail-text data-v-104c27e4">{{item.time}}</text></view><view class="store-detail data-v-104c27e4"><text class="detail-text data-v-104c27e4">{{item.address}}</text></view></view><view class="store-action data-v-104c27e4"><text class="action-text data-v-104c27e4">选择门店</text><text class="distance data-v-104c27e4">{{"距离"+item.distance}}</text></view></view></block></view><view data-event-opts="{{[['tap',[['viewAllStores',['$event']]]]]}}" class="footer-btn data-v-104c27e4" bindtap="__e"><text class="data-v-104c27e4">选择其他门店 <text class="iconfont icon-youjiantou data-v-104c27e4"></text></text></view></view></view>