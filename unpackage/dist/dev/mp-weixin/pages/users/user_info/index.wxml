ature||'个性签名'}}</text><text class="item-arrow iconfont icon-youjiantou data-v-6115a516"></text></view></view><view data-event-opts="{{[['tap',[['handleMemberCode',['$event']]]]]}}" class="info-item data-v-6115a516" bindtap="__e"><view class="item-label data-v-6115a516">我的会员码</view><view class="item-content data-v-6115a516"><view class="member-code-icon data-v-6115a516"><text class="data-v-6115a516">码</text></view><text class="item-arrow iconfont icon-youjiantou data-v-6115a516"></text></view></view><view data-event-opts="{{[['tap',[['handleInvoice',['$event']]]]]}}" class="info-item data-v-6115a516" bindtap="__e"><view class="item-label data-v-6115a516">我的发票</view><view class="item-content data-v-6115a516"><text class="item-arrow iconfont icon-youjiantou data-v-6115a516"></text></view></view><view data-event-opts="{{[['tap',[['handleFeedback',['$event']]]]]}}" class="info-item data-v-6115a516" bindtap="__e"><view class="item-label data-v-6115a516">帮助与反馈</view><view class="item-content data-v-6115a516"><text class="item-arrow iconfont icon-youjiantou data-v-6115a516"></text></view></view><block wx:if="{{showNicknameModal}}"><view class="modal data-v-6115a516"><view data-event-opts="{{[['tap',[['closeNicknameModal',['$event']]]]]}}" class="modal-mask data-v-6115a516" bindtap="__e"></view><view class="modal-content card data-v-6115a516"><view class="modal-header data-v-6115a516"> 修改昵称 </view><view class="modal-body data-v-6115a516"><input class="nickname-input data-v-6115a516" placeholder="请输入新的昵称" data-event-opts="{{[['input',[['__set_model',['','newNickname','$event',[]]]]]]}}" value="{{newNickname}}" bindinput="__e"/></view><view class="modal-footer flex flex--row data-v-6115a516"><view data-event-opts="{{[['tap',[['closeNicknameModal',['$event']]]]]}}" class="modal-btn cancel-btn data-v-6115a516" bindtap="__e">取消</view><view data-event-opts="{{[['tap',[['confirmNicknameChange',['$event']]]]]}}" class="modal-btn confirm-btn data-v-6115a516" bindtap="__e">确定</view></