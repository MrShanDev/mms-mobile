.user-collect-page {
  min-height: 100vh;
  background: #FBF9FD;
}
.list-container {
  padding: 32rpx 30rpx;
  background-color: #FBF9FD;
}
.list-container .list-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2F2F2F;
  margin-bottom: 24rpx;
}
.list-container .store-list .store-card {
  background: #FFF;
  border: 2rpx solid #E6E7E9;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.list-container .store-list .store-card .card-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 20rpx;
}
.list-container .store-list .store-card .card-content .store-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.list-container .store-list .store-card .card-content .store-header .name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.list-container .store-list .store-card .card-content .store-header .name-row .store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2F2F2F;
}
.list-container .store-list .store-card .card-content .store-header .name-row .store-badge {
  background: #FFF8E8;
  color: #FB0A0A;
  border: 1rpx solid #FB0A0A;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.list-container .store-list .store-card .card-content .store-info {
  margin-bottom: 8rpx;
}
.list-container .store-list .store-card .card-content .store-info .info-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}
.list-container .store-list .store-card .card-content .store-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
}
.list-container .store-list .store-card .card-content .store-footer .action-btn {
  color: #050505;
  font-weight: 600;
}
.list-container .store-list .store-card .card-content .store-footer .distance {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #737070;
}
.list-container .store-list .store-card .card-content .store-footer .icon-group {
  margin-top: 15rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.list-container .store-list .store-card .card-content .store-footer .icon-group .icons {
  width: 35rpx;
  height: 35rpx;
}
.list-container .store-list .store-card .card-content .store-footer .icon-group .icons image {
  width: 100%;
  height: 100%;
}
