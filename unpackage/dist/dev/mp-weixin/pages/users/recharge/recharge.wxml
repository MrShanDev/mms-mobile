<view class="recharge-page data-v-4a28a25f"><view class="balance-card data-v-4a28a25f"><view class="balance-label data-v-4a28a25f">账户余额（元）</view><view class="balance-amount data-v-4a28a25f">{{accountBalance}}</view></view><view class="recharge-section data-v-4a28a25f"><view class="section-title data-v-4a28a25f">充值金额</view><view class="amount-options data-v-4a28a25f"><block wx:for="{{amountOptions}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectAmount',['$0'],[[['amountOptions','',index,'value']]]]]]]}}" class="{{['amount-item','data-v-4a28a25f',(selectedAmount===item.value)?'active':'']}}" bindtap="__e"><view class="amount-value data-v-4a28a25f">{{"¥ "+item.value}}</view><block wx:if="{{item.gift}}"><view class="amount-gift data-v-4a28a25f">{{"赠"+item.gift}}</view></block><block wx:if="{{selectedAmount===item.value}}"><view class="check-icon data-v-4a28a25f"><text class="data-v-4a28a25f">✓</text></view></block></view></block></view><view class="custom-amount data-v-4a28a25f"><text class="currency-symbol data-v-4a28a25f">¥</text><input type="number" placeholder="输入自定义金额" data-event-opts="{{[['input',[['__set_model',['','customAmount','$event',[]]],['handleCustomInput',['$event']]]]]}}" value="{{customAmount}}" bindinput="__e" class="data-v-4a28a25f"/></view></view><view class="recharge-notice data-v-4a28a25f"><view class="notice-title data-v-4a28a25f">充值说明</view><view class="notice-item data-v-4a28a25f"><text class="dot data-v-4a28a25f">•</text><text class="notice-text data-v-4a28a25f">充值金额永久有效</text></view><view class="notice-item data-v-4a28a25f"><text class="dot data-v-4a28a25f">•</text><text class="notice-text data-v-4a28a25f">若遇充值问题，请<text data-event-opts="{{[['tap',[['contactService',['$event']]]]]}}" class="link data-v-4a28a25f" bindtap="__e">联系客服</text></text></view></view><view data-event-opts="{{[['tap',[['confirmRecharge',['$event']]]]]}}" class="submit-btn data-v-4a28a25f" bindtap="__e"><text class="data-v-4a28a25f">确认充值</text></view></view>