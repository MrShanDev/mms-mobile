<view class="balance-page data-v-e7eff60e"><view class="balance-card data-v-e7eff60e"><view class="card-content data-v-e7eff60e"><view class="balance-label data-v-e7eff60e">可提现余额（元）</view><view class="balance-amount data-v-e7eff60e">{{balance}}</view><view class="card-actions data-v-e7eff60e"><view data-event-opts="{{[['tap',[['handleRecharge',['$event']]]]]}}" class="action-btn data-v-e7eff60e" bindtap="__e"><text class="data-v-e7eff60e">充值</text></view><view data-event-opts="{{[['tap',[['handleWithdraw',['$event']]]]]}}" class="action-btn data-v-e7eff60e" bindtap="__e"><text class="data-v-e7eff60e">提现</text></view></view></view></view><view class="detail-section data-v-e7eff60e"><view class="detail-header data-v-e7eff60e"><text class="detail-title data-v-e7eff60e">余额明细</text><view data-event-opts="{{[['tap',[['viewAllBalance',['$event']]]]]}}" class="view-all data-v-e7eff60e" bindtap="__e"><text class="data-v-e7eff60e">查看全部</text><text class="arrow iconfont icon-youjiantou data-v-e7eff60e"></text></view></view><view class="balance-list data-v-e7eff60e"><block wx:for="{{balanceList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="balance-item data-v-e7eff60e"><view class="item-left data-v-e7eff60e"><view class="item-title data-v-e7eff60e">{{item.title}}</view><view class="item-date data-v-e7eff60e">{{item.date}}</view></view><view class="item-right data-v-e7eff60e"><text class="{{['balance-change','data-v-e7eff60e',item.type==='income'?'income':'expense']}}">{{item.change}}</text></view></view></block></view></view></view>