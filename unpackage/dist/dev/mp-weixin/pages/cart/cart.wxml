<view class="cart-page data-v-0f00adf4"><block wx:if="{{$root.g0>0}}"><view class="cart-content data-v-0f00adf4"><scroll-view class="cart-scroll data-v-0f00adf4" scroll-y="{{true}}"><block wx:for="{{cartList}}" wx:for-item="store" wx:for-index="storeIndex" wx:key="storeIndex"><view class="store-group data-v-0f00adf4"><view class="store-header data-v-0f00adf4"><view data-event-opts="{{[['tap',[['toggleStoreSelect',[storeIndex]]]]]}}" class="store-left data-v-0f00adf4" bindtap="__e"><view class="{{['checkbox','data-v-0f00adf4',(store.selected)?'checked':'']}}"><block wx:if="{{store.selected}}"><text class="iconfont icon-duihao data-v-0f00adf4"></text></block></view><view class="store-icon data-v-0f00adf4"><text class="icon-text data-v-0f00adf4">牛</text></view><text class="store-name data-v-0f00adf4">{{store.storeName}}</text><text class="iconfont icon-youjiantou arrow-icon data-v-0f00adf4"></text></view><view class="action-btns data-v-0f00adf4"><text data-event-opts="{{[['tap',[['clearStore',[storeIndex]]]]]}}" class="delete-btn iconfont icon-shanchu data-v-0f00adf4" bindtap="__e"></text><text data-event-opts="{{[['tap',[['clearStore',[storeIndex]]]]]}}" class="clear-text data-v-0f00adf4" bindtap="__e">清空</text></view></view><view class="goods-list data-v-0f00adf4"><block wx:for="{{store.goodsList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="goods-item data-v-0f00adf4"><view data-event-opts="{{[['tap',[['toggleGoodsSelect',[storeIndex,index]]]]]}}" class="{{['checkbox','data-v-0f00adf4',(item.selected)?'checked':'']}}" bindtap="__e"><block wx:if="{{item.selected}}"><text class="iconfont icon-duihao data-v-0f00adf4"></text></block></view><image class="goods-img data-v-0f00adf4" src="{{item.image}}" mode="aspectFill"></image><view class="goods-info data-v-0f00adf4"><view class="goods-name data-v-0f00adf4">{{item.name}}</view><view class="goods-spec data-v-0f00adf4">{{item.spec}}</view><view class="goods-bottom data-v-0f00adf4"><text class="price data-v-0f00adf4">{{"¥ "+item.price}}</text><view class="count-control data-v-0f00adf4"><view data-event-opts="{{[['tap',[['decreaseCount',[storeIndex,index]]]]]}}" class="minus-btn data-v-0f00adf4" bindtap="__e">−</view><input class="count-input data-v-0f00adf4" type="number" disabled="{{true}}" value="{{item.count}}"/><view data-event-opts="{{[['tap',[['increaseCount',[storeIndex,index]]]]]}}" class="plus-btn data-v-0f00adf4" bindtap="__e">+</view></view></view></view></view></block></view></view></block></scroll-view></view></block><block wx:else><view class="empty-cart data-v-0f00adf4"><image class="empty-img data-v-0f00adf4" src="https://sxpcwlkj.oss-cn-beijing.aliyuncs.com/ordermeal/empty-cart.png" mode="aspectFit"></image><text class="empty-text data-v-0f00adf4">购物车空空如也~</text><view data-event-opts="{{[['tap',[['goShopping',['$event']]]]]}}" class="go-shopping-btn data-v-0f00adf4" bindtap="__e">去逛逛</view></view></block><block wx:if="{{$root.g1>0}}"><view class="bottom-bar data-v-0f00adf4"><view class="bar-left data-v-0f00adf4"><view data-event-opts="{{[['tap',[['toggleAllSelect',['$event']]]]]}}" class="{{['checkbox','data-v-0f00adf4',(allSelected)?'checked':'']}}" bindtap="__e"><block wx:if="{{allSelected}}"><text class="iconfont icon-duihao data-v-0f00adf4"></text></block></view><view class="select-info data-v-0f00adf4"><view class="data-v-0f00adf4"><text class="total-label data-v-0f00adf4">合计</text><text class="free-delivery data-v-0f00adf4">(不含运费)</text><text class="total-price p-l-10 data-v-0f00adf4">{{"¥ "+totalPrice}}</text></view><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="detail-toggle data-v-0f00adf4" bindtap="__e"><text class="free-text data-v-0f00adf4">免运费</text><text class="detail-text data-v-0f00adf4">明细</text><text class="{{['iconfont','data-v-0f00adf4',showDetail?'icon-shangjiantou':'icon-xiajiantou']}}"></text></view></view></view><view data-event-opts="{{[['tap',[['goCheckout',['$event']]]]]}}" class="{{['checkout-btn','data-v-0f00adf4',(selectedCount===0)?'disabled':'']}}" bindtap="__e">{{'去下单('+selectedCount+')'}}</view></view></block><block wx:if="{{showDetail}}"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="detail-modal data-v-0f00adf4" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="detail-content data-v-0f00adf4" catchtap="__e"><view class="detail-row data-v-0f00adf4"><text class="label data-v-0f00adf4">商品金额</text><text class="value data-v-0f00adf4">{{"¥"+totalPrice}}</text></view><view class="detail-row data-v-0f00adf4"><text class="label data-v-0f00adf4">配送费</text><text class="value data-v-0f00adf4">¥0.00</text></view><view class="detail-row total data-v-0f00adf4"><text class="label data-v-0f00adf4">合计</text><text class="value data-v-0f00adf4">{{"¥"+totalPrice}}</text></view></view></view></block></view>