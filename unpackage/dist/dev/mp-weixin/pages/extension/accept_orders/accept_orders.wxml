<view class="apply-delivery-page data-v-48b32c30"><view class="tab-bar data-v-48b32c30"><block wx:for="{{tabs}}" wx:for-item="tab" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchTab',[index]]]]]}}" class="{{['tab-item','data-v-48b32c30',(activeTab===index)?'active':'']}}" bindtap="__e"><text class="data-v-48b32c30">{{tab}}</text></view></block></view><view class="order-list data-v-48b32c30"><block wx:for="{{orderList}}" wx:for-item="order" wx:for-index="index" wx:key="index"><view class="order-item data-v-48b32c30"><view class="order-header data-v-48b32c30"><view class="flex justify--between align--center data-v-48b32c30"><view class="order-number data-v-48b32c30">{{"#"+order.orderNo}}</view><view class="m-l-15 data-v-48b32c30" style="color:#575656;font-size:25rpx;">顾客已等11分钟（9:15前送达）</view></view><view class="order-time data-v-48b32c30"><text class="status-tag data-v-48b32c30"> 订单信息 <text class="iconfont icon-youjiantou data-v-48b32c30"></text></text></view></view><view class="location-item data-v-48b32c30"><view class="data-v-48b32c30"><view class="location-icon location-icon-start data-v-48b32c30"><text class="data-v-48b32c30">取</text></view><view class="location-distance data-v-48b32c30">{{order.endDistance+"km"}}</view></view><view class="location-info data-v-48b32c30"><view class="location-label data-v-48b32c30">牛堡堡</view><view class="location-address data-v-48b32c30">{{order.startAddress}}</view></view></view><view class="location-item data-v-48b32c30"><view class="data-v-48b32c30"><view class="location-icon location-icon-end data-v-48b32c30"><text class="data-v-48b32c30">收</text></view><view class="location-distance data-v-48b32c30">{{order.endDistance+"km"}}</view></view><view class="location-info data-v-48b32c30"><view class="location-label data-v-48b32c30">{{order.recipientName}}</view><view class="location-address data-v-48b32c30">{{order.endAddress}}</view></view></view><view class="order-actions data-v-48b32c30"><view data-event-opts="{{[['tap',[['handleContact',['$0'],[[['orderList','',index]]]]]]]}}" class="action-btn action-btn-outline data-v-48b32c30" bindtap="__e"><text class="data-v-48b32c30">{{order.contactText}}</text></view><view data-event-opts="{{[['tap',[['handleNavigate',['$0'],[[['orderList','',index]]]]]]]}}" class="action-btn action-btn-outline data-v-48b32c30" bindtap="__e"><text class="data-v-48b32c30">{{order.navigateText}}</text></view></view><view class="order-footer data-v-48b32c30"><view data-event-opts="{{[['tap',[['handleFooterBtn1',['$0'],[[['orderList','',index]]]]]]]}}" class="{{['footer-btn','data-v-48b32c30',order.footerBtn1Class]}}" bindtap="__e"><text class="data-v-48b32c30">{{order.footerBtn1Text}}</text></view><view data-event-opts="{{[['tap',[['handleFooterBtn2',['$0'],[[['orderList','',index]]]]]]]}}" class="{{['footer-btn','data-v-48b32c30',order.footerBtn2Class]}}" bindtap="__e"><text class="data-v-48b32c30">{{order.footerBtn2Text}}</text></view></view></view></block></view></view>