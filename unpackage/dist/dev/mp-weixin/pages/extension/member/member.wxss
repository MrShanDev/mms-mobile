.member-page {
  overflow: hidden;
  min-height: 100vh;
  background: url(https://sxpcwlkj.oss-cn-beijing.aliyuncs.com/ordermeal/bj.png);
  background-size: 100% 100%;
}
.nav-bar {
  padding: 120rpx 30rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
.nav-bar .nav-left {
  position: absolute;
  left: 30rpx;
  top: 120rpx;
}
.nav-bar .nav-left .back-icon {
  font-size: 48rpx;
  font-weight: 600;
  color: #2F2F2F;
}
.nav-bar .nav-title {
  width: 100%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #2F2F2F;
}
.vip_get {
  margin: 100rpx auto 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.vip_get .vip {
  font-size: 100rpx;
  font-weight: 600;
}
.vip_get .vip_btn {
  margin-top: 30rpx;
  padding: 20rpx 0;
  width: 70%;
  text-align: center;
  color: #232222;
  background-color: #FADCB1;
}
.join {
  padding: 0 30rpx;
}
.join .join-title {
  font-size: 30rpx;
  color: #0A0A0A;
  font-weight: 600;
  margin-bottom: 15rpx;
}
.join .join-image {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: url(https://sxpcwlkj.oss-cn-beijing.aliyuncs.com/ordermeal/member.png);
  background-size: 100% 100%;
}
.join .join-image .save {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 10rpx 80rpx;
  border-radius: 40rpx;
  background-color: #F99204;
  color: #fff;
}
.conpon {
  padding: 30rpx;
}
.conpon .conpon-title {
  font-size: 30rpx;
  color: #0A0A0A;
  font-weight: 600;
  margin-bottom: 15rpx;
}
.conpon .conpon-content {
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  background-color: #FADCB1;
  display: flex;
  align-items: center;
  padding: 50rpx 30rpx;
}
.conpon .conpon-content .conpon-box1 {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 600;
}
.conpon .conpon-content .conpon-box1 text {
  font-weight: 400;
  font-size: 20rpx;
  margin-right: 10rpx;
}
.conpon .conpon-content .conpon-box2 {
  flex: 1;
}
