<view class="add-storage-container data-v-d899f39c"><view class="storage-info-section data-v-d899f39c"><view class="section-title data-v-d899f39c">添加储物信息</view><view class="input-wrapper data-v-d899f39c"><input class="input-field data-v-d899f39c" placeholder="请输入物品名称" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['','itemName','$event',[]]]]]]}}" value="{{itemName}}" bindinput="__e"/></view><view class="input-wrapper data-v-d899f39c"><input class="input-field data-v-d899f39c" type="number" placeholder="请输入物品数量" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['','itemQuantity','$event',[]]]]]]}}" value="{{itemQuantity}}" bindinput="__e"/></view></view><view class="photo-section data-v-d899f39c"><view class="section-title data-v-d899f39c">添加物品照片</view><view class="photo-upload-area data-v-d899f39c"><block wx:for="{{photoList}}" wx:for-item="photo" wx:for-index="index" wx:key="index"><view class="photo-item data-v-d899f39c"><image class="photo-image data-v-d899f39c" src="{{photo}}" mode="aspectFill"></image><view data-event-opts="{{[['tap',[['deletePhoto',[index]]]]]}}" class="delete-btn data-v-d899f39c" bindtap="__e"><u-icon vue-id="{{'3aa37dd8-1-'+index}}" name="close" color="#fff" size="12" class="data-v-d899f39c" bind:__l="__l"></u-icon></view></view></block><block wx:if="{{$root.g0<9}}"><view data-event-opts="{{[['tap',[['choosePhoto',['$event']]]]]}}" class="upload-btn data-v-d899f39c" bindtap="__e"><u-icon vue-id="3aa37dd8-2" name="plus" color="#CCCCCC" size="40" class="data-v-d899f39c" bind:__l="__l"></u-icon><text class="upload-text data-v-d899f39c">图片</text></view></block></view><view class="upload-tip data-v-d899f39c">上传评价图片或视频</view></view><view class="submit-wrapper data-v-d899f39c"><view data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" class="submit-btn data-v-d899f39c" bindtap="__e"><text class="btn-text data-v-d899f39c">储物</text></view></view></view>